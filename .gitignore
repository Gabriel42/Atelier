# Asset library: the framework (notes, folder layout, tools) goes to GitHub,
# the assets themselves never do (several pack licences forbid sharing the files).
library/**
!library/**/
!library/README.md
!library/sources.md
!library/*/.gitkeep

# Built pages (the main menu copy to upload)
build/

# The taskbar shortcut (made per computer by: node tools/menu/menu.mjs --shortcut)
Atelier.lnk
